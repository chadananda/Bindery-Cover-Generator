{
  "name": "cover-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof-of-concept book-cover generator: Gemini art, chroma-key cutout, layered styles, Cloudflare Worker + R2.",
  "scripts": {
    "build": "node scripts/copy-core.mjs",
    "dev": "node scripts/copy-core.mjs && wrangler dev",
    "deploy": "node scripts/copy-core.mjs && wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  },
  "license": "MIT"
}
