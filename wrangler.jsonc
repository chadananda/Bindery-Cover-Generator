{
  // Personal Cloudflare account (Chad, 2026-10-02).
  "name": "cover-generator",
  "account_id": "b750d0f7242bbc76f115f72840453083",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // public/core/ is a generated copy of core/ (scripts/copy-core.mjs). It is made by `npm run dev` /
  // `npm run deploy`, NOT a wrangler build hook: the hook ran after the asset manifest was taken, so a
  // core change shipped stale. Always deploy through `npm run deploy`.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "cover-generator" }],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): GEMINI_API_KEY, PASSCODE. Optional var: GEMINI_MODEL.
}
