{
  // Personal Cloudflare account (Chad, 2026-10-02).
  "name": "cover-generator",
  "account_id": "b750d0f7242bbc76f115f72840453083",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // public/core/ is a generated copy of core/ (scripts/copy-core.mjs). It is made by `npm run dev` /
  // `npm run deploy`, NOT a wrangler build hook: the hook ran after the asset manifest was taken, so a
  // core change shipped stale. Always deploy through `npm run deploy`.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Clean paths (/oceanlibrary, /oceanlibrary/islam) all serve index.html; app.js routes on the path.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  // Public URL (Chad, 2026-10-02). Adding it turned the workers.dev address off — one canonical URL.
  "routes": [{ "pattern": "bindery.lnker.com", "custom_domain": true }],
  // Images in R2, data + prompts in D1 (migrations/). "remote": true = `npm run dev` reads and writes the
  // LIVE bucket and database, so local work sees real data. There is no separate dev copy.
  "r2_buckets": [{ "binding": "COVERS", "bucket_name": "cover-generator", "remote": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "bindery", "database_id": "4b54e68c-341b-4e7c-b4b8-2905e6f84631", "remote": true }],
  // Pinned dev port — unique across Chad's projects (8787 is taken elsewhere).
  "dev": { "port": 8788 },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): GEMINI_API_KEY, PASSCODE. Optional var: GEMINI_MODEL.
}
